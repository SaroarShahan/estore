{
  "name": "estore",
  "version": "1.0.0",
  "main": "src/Index.js",
  "repository": "git@github.com:SaroarShahan/estore.git",
  "author": "SaroarShahan",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "dev": "nodemon src/Index.js",
    "start": "node src/Index.js",
    "format": "prettier --write .",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo",
    "seed:undo:all": "sequelize-cli db:seed:undo:all",
    "migration:gen": "sequelize-cli migration:generate --name",
    "model:gen": "sequelize-cli model:generate --name"
  },
  "lint-staged": {
    "*.js": "node --check"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cls-rtracer": "^2.6.4",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  },
  "overrides": {
    "sequelize": {
      "uuid": "14.0.1"
    }
  },
  "engines": {
    "node": "24.15.0"
  },
  "volta": {
    "node": "24.15.0"
  }
}
